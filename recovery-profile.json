{
  "schemaVersion": 1,
  "profileVersion": 2,
  "id": "fieldwork",
  "app": "fieldwork",
  "stateful": true,
  "components": [
    {
      "id": "studio-data",
      "kind": "store",
      "required": true,
      "restoreOwner": "fieldwork",
      "bindings": [
        {
          "type": "sqlite",
          "root": "data",
          "path": "studio.sqlite"
        }
      ]
    },
    {
      "id": "account-encryption-keys",
      "kind": "key",
      "required": false,
      "restoreOwner": "fieldwork",
      "bindings": [
        {
          "type": "key-directory",
          "root": "data",
          "path": "keys"
        }
      ]
    }
  ]
}
